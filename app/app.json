{
  "expo": {
    "name": "Charvis",
    "slug": "charvis",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.charvis.casco"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.charvis.casco"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Charvis usa Bluetooth para conectarse al sensor del casco."
        }
      ]
    ],
    "owner": "agustinaazanis000",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aa1bc47c-63f4-4633-883c-ee3666b283e6"
    },
    "extra": {
      "eas": {
        "projectId": "aa1bc47c-63f4-4633-883c-ee3666b283e6"
      }
    }
  }
}
